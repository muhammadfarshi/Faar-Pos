# ─── FAAR POS Backend Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values
# Never commit the actual .env to version control

# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://faar_user:faar_password@localhost:5432/faar_pos

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT Security ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-real-secret-key-in-production-use-32-chars-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── App Settings ─────────────────────────────────────────────────────────
PROJECT_NAME=FAAR POS
VERSION=1.0.0
DEBUG=true

# ─── CORS (comma-separated origins) ───────────────────────────────────────
# For local dev: allow all. In production: list specific origins.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","http://10.0.2.2:8080"]

# ─── Docker Compose settings (used by docker-compose.yml) ─────────────────
POSTGRES_DB=faar_pos
POSTGRES_USER=faar_user
POSTGRES_PASSWORD=faar_password
